{
  "$schema": "http://json-schema.org",
  "title": "GeminiControlEventOutputContractV6",
  "type": "object",
  "required": [
    "thread_mutation",
    "execution_intent",
    "required_materials",
    "assistant_response"
  ],
  "additionalProperties": false,
  "properties": {
    "thread_mutation": {
      "type": "object",
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "MAINTAIN",
            "SWITCH",
            "OPEN_NEW",
            "CLOSE"
          ]
        },
        "target_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_goal": {
          "type": "string"
        },
        "focus_entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "execution_intent": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NO_ACTION_REQUIRED",
            "EXECUTE_UI",
            "EXECUTE_DATA",
            "NEED_MATERIALS",
            "NEED_ENTITY_RESOLUTION"
          ]
        },
        "source_evidence_id": {
          "type": "string"
        },
        "entity_resolution_overrides": {
          "type": "array"
        },
        "entity_resolution_query": {
          "type": "object"
        },
        "pipeline": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "required_materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assistant_response": {
      "type": "object",
      "required": [
        "should_render_now",
        "reply"
      ],
      "additionalProperties": false,
      "properties": {
        "should_render_now": {
          "type": "boolean"
        },
        "reply": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}